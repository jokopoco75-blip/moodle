PORT=3000
DATA_DIR=./data

# Для production замените NODE_ENV на production и задайте ADMIN_PASSWORD.
# В development создаются демонстрационные аккаунты с паролем demo1234.
NODE_ENV=development
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Необязательно: без ключа ИИ-кнопки покажут локальные подсказки.
# Ключ хранится на сервере и никогда не отправляется в браузер.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
